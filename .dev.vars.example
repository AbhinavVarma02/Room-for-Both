# Copy to .dev.vars for local development. .dev.vars is git-ignored and must never be committed.
# For a deployed Worker, set each secret with `npx wrangler secret put NAME` instead.

# Qloo API credential issued to you. Leave empty to run in labelled fixture mode.
QLOO_API_KEY=
# Optional. Defaults to Qloo's documented production host. Must be an https URL on a qloo.com host.
# Use the host named in your credential instructions. If unsure, leave it empty and list candidates below:
# `npm run smoke:live` probes each with one call and reports which one accepts the key.
QLOO_BASE_URL=
# Comma-separated candidate hosts for the smoke-test probe (local only).
QLOO_CANDIDATE_BASE_URLS=

# Optional plain-language summaries via the Gemini Developer API. Both must be set to enable.
# Use a Google AI Studio key from a project without billing, so only the free tier applies, and a model that
# is free for your account (check Google's pricing page). `npm run smoke:gemini` checks both with two calls.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional secret salt for the daily-rotating client hash used by rate limits.
CLIENT_KEY_SALT=
