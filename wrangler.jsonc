{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "room-for-both",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "room-for-both",
      "migrations_dir": "db/migrations"
    }
  ],
  "triggers": {
    // Daily cleanup of expired host-response links and rate-limit windows.
    "crons": ["17 4 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "QLOO_MAX_CALLS_PER_RUN": "6",
    "QLOO_DAILY_CALL_CEILING": "1500",
    "RESEARCH_RUNS_PER_HOUR_PER_CLIENT": "12",
    "QLOO_TIMEOUT_MS": "8000"
  }
}
