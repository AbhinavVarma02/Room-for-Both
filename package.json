{
  "name": "room-for-both",
  "version": "0.1.0",
  "private": true,
  "description": "Room for Both — find common ground and build a better deal between two independent businesses.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "eval": "tsx tests/evaluation/run.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run eval && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply room-for-both --local",
    "db:migrate:remote": "wrangler d1 migrations apply room-for-both --remote",
    "deploy": "npm run build && wrangler deploy",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "verify:public": "tsx scripts/verify-public.ts",
    "scan:secrets": "tsx scripts/scan-repo.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.104.3",
    "clsx": "2.1.1",
    "hono": "4.13.13",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
